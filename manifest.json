{
  "manifest_version": 3,
  "name": "Emochi Character Card Exporter",
  "version": "0.1.0",
  "description": "Exporta localmente fichas visibles de Emochi a JSON de SillyTavern y PNG.",
  "icons": {
    "128": "assets/inkwell-mark.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://emochi.com/*",
        "https://www.emochi.com/*"
      ],
      "js": [
      "src/scraper.js",
      "src/exporters.js",
      "src/panel.js"
    ]
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "assets/inkwell-mark.png",
        "assets/inkwell-wordmark.webp",
        "assets/fonts/google-sans-flex-latin-ext-wght-normal.woff2",
        "assets/fonts/google-sans-flex-latin-wght-normal.woff2",
        "assets/fonts/inter-latin-ext-wght-normal.woff2",
        "assets/fonts/inter-latin-wght-normal.woff2"
      ],
      "matches": [
        "https://emochi.com/*",
        "https://www.emochi.com/*"
      ]
    }
  ],
  "permissions": [],
  "host_permissions": []
}
