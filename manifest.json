{
  "manifest_version": 3,
  "name": "Card Extractor - JanitorAI + Emochi + Polybuzz",
  "version": "0.7.6",
  "description": "Extract a character card from JanitorAI, Emochi or Polybuzz and export it to SillyTavern JSON or PNG (both read by Tavo), a lorebook (World Info) JSON, JanitorAI JSON, or plain text. Runs entirely in your browser using your own session - nothing is sent to any server.",
  "icons": {
    "128": "assets/inkwell-mark.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*"
      ],
      "js": [
        "src/scraper.js",
        "src/exporters.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://emochi.com/*",
        "https://www.emochi.com/*"
      ],
      "js": [
        "src/emochi.js",
        "src/exporters.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://polybuzz.ai/*",
        "https://www.polybuzz.ai/*"
      ],
      "js": [
        "src/polybuzz.js",
        "src/exporters.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "assets/inkwell-mark.png",
        "assets/inkwell-wordmark.webp",
        "assets/fonts/google-sans-flex-latin-ext-wght-normal.woff2",
        "assets/fonts/google-sans-flex-latin-wght-normal.woff2",
        "assets/fonts/inter-latin-ext-wght-normal.woff2",
        "assets/fonts/inter-latin-wght-normal.woff2"
      ],
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*",
        "https://emochi.com/*",
        "https://www.emochi.com/*",
        "https://polybuzz.ai/*",
        "https://www.polybuzz.ai/*"
      ]
    }
  ],
  "permissions": [],
  "host_permissions": [
    "https://emochi-backend-k8s.flowgpt.com/*",
    "https://c6-api.polybuzz.ai/*",
    "https://polybuzz.ai/*",
    "https://www.polybuzz.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
